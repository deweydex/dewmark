        {
          "name": "a1",
          "marks": 5,
          "topic": "comprehension",
          "prose": "### Question A2 \u2014 How the argument is built",
          "answers": [
            {
              "settings": {
                "name": "a1.position",
                "type": "short-written-answer",
                "marks": 5,
                "prompt": "In one or two sentences of your own, state the conclusion the writer reaches. Take care: it is not \"recordings are bad\".\n",
                "model_answer": "The writer concludes that recording has real costs as well as real\nbenefits, so each college must weigh the two losses and decide for\nitself. The writer does not come down on either side."
              },
              "marking": {
                "method": "marks-out-of-a-total",
                "guidance": [
                  "3 marks for seeing that the writer takes neither side",
                  "2 marks for the idea of weighing two kinds of loss",
                  "a summary of only the benefits, or only the costs, earns at most 2"
                ],
                "marks": 5
              }
            }
          ]
        },
        {
          "name": "a2",
          "marks": 10,
          "topic": "analysis",
          "prose": "### Question A3 \u2014 Your own view, briefly",
          "answers": [
            {
              "settings": {
                "name": "a2.technique",
                "type": "long-written-answer",
                "marks": 10,
                "prompt": "Identify two techniques the writer uses to persuade, and quote the words where each appears. For each technique, explain what it does to the reader.\n",
                "model_answer": "The writer uses the rule of three: \"the room, the routine, and the\ncompany\" and the October/May contrast pile up concrete details, so\nthe loss feels real rather than claimed. The writer also uses a\nbalanced turn: \"not between convenience and tradition... between\ntwo different kinds of loss\" reframes the whole question, which\nmakes the writer sound fair and makes the reader trust the\nconclusion. Other defensible answers include the short blunt\nsentence \"A recording preserves the words of a class but not the\nclass\", which lands the central distinction."
              },
              "marking": {
                "method": "marks-out-of-a-total",
                "guidance": [
                  "5 marks per technique - 2 for naming it, 1 for the quotation, 2 for the effect on the reader",
                  "any two defensible techniques earn the marks; the model lists three the passage supports"
                ],
                "marks": 10
              }
            }
          ]
        },
        {
          "name": "a3",
          "marks": 15,
          "topic": "response",
          "prose": "",
          "answers": [
            {
              "settings": {
                "name": "a3.response",
                "type": "long-written-answer",
                "marks": 15,
                "prompt": "In about 150 words, agree or disagree with the writer's claim that \"the students who stop coming are often the ones who most need the room\". Give one reason from your own experience or observation, and one piece of evidence the writer would need to show to convince you fully.\n",
                "model_answer": "A strong answer takes a clear side in the first sentence, supports\nit with one specific observed case, and then names checkable\nevidence, such as attendance figures compared with results for the\nsame students. The side taken does not matter; the marks follow\nthe reasoning."
              },
              "marking": {
                "method": "marks-out-of-a-total",
                "guidance": [
                  "5 marks for a clear stated position",
                  "5 marks for one specific reason from experience or observation",
                  "5 marks for naming evidence that could actually be gathered"
                ],
                "marks": 15
              }
            }
          ]
        }
      ]
    },
